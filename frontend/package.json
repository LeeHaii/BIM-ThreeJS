{
  "name": "@bim/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm runtime:assets && tsc -p tsconfig.json && vite build",
    "dev": "pnpm runtime:assets && vite",
