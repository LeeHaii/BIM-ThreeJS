    "@thatopen/components-front": "3.4.4",
    "@thatopen/fragments": "3.4.7",
    "camera-controls": "3.1.2",
    "three": "0.184.0",
    "web-ifc": "0.0.77",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/three": "0.184.0",
    "vite": "7.1.3"
  }
}
